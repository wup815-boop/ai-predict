# ============================================================
# AI Product Prediction Service - Environment Variables
# ============================================================
# このファイルを .env.local にコピーして値を入力してください
# cp .env.example .env.local

# --- Product Hunt ---
# https://www.producthunt.com/v2/oauth/applications で取得
PH_DEVELOPER_TOKEN=

# --- GitHub ---
# https://github.com/settings/tokens で Personal Access Token を生成
# public_repo スコープのみで十分
GITHUB_TOKEN=

# --- Supabase ---
# https://supabase.com → プロジェクト → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=   # openssl rand -base64 32 で生成

# --- Resend (週次結果通知メール) ---
# https://resend.com でサインアップ → API Keys で発行
RESEND_API_KEY=
# 送信元アドレス。独自ドメインを検証するまでは onboarding@resend.dev のみ使用可（送信先が制限されます）
EMAIL_FROM=AI Predict <onboarding@resend.dev>
